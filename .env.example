# Client-side (expuestas al navegador, seguras por diseño)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor: credencial con permisos de service_role.
# Úsala únicamente en Route Handlers / Server Actions (app/api/**).
# Nunca la expongas con NEXT_PUBLIC_ ni la importes desde un 'use client'.
SUPABASE_SERVICE_ROLE_KEY=
